                if pending_trade_setup_day[0] == self._selected_report_day_key:
                    report_inactive_trades[0] = report_inactive_trades[0] + 1.0
                    report_trades[0] = report_active_trades[0] + report_inactive_trades[0]

                    # Hypothetical inactive-order P/L: deliberately ignore whether
                    # the planned entry was reached. Use the original planned
                    # entry/SL/TP and conservative SL-first same-candle handling.
                    inactive_exit_price = pending_sl_value if pending_sl_touched else pending_tp_value
                    inactive_result = (
                        (inactive_exit_price - pending_entry_value)
                        * pending_side_value
                        * self.contract_size
                        * pending_trade_lot[0]
                    )
                    report_inactive_pnl[0] = report_inactive_pnl[0] + inactive_result

                # Show the final pending-order status on its resolution candle.
                inactive_status_text = (
