                    elif day_number == 21:
                        day_profit = monthly_day_21_profit[0]
                    elif day_number == 22:
                        day_profit = monthly_day_22_profit[0]
                    elif day_number == 23:
                        day_profit = monthly_day_23_profit[0]
                    elif day_number == 24:
                        day_profit = monthly_day_24_profit[0]
                    elif day_number == 25:
                        day_profit = monthly_day_25_profit[0]
                    elif day_number == 26:
