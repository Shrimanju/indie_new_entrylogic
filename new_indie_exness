            label_width = 44
            value_width = 18

            top_border = (
                '+' + ('-' * (label_width + 2))
                + '+' + ('-' * (value_width + 2)) + '+'
            )

            header_row = (
                '| ' + '𝗞𝗦 𝗧𝗥𝗔𝗗𝗘𝗥 𝗗𝗘𝗦𝗞 - 𝗗𝗔𝗜𝗟𝗬 / 𝗠𝗢𝗡𝗧𝗛𝗟𝗬 𝗣/𝗟'.ljust(label_width) + ' | '
                + 'RESULT'.ljust(value_width) + ' |'
            )

            date_row = (
                '| ' + 'Date'.ljust(label_width) + ' | '
                + date_label.ljust(value_width) + ' |'
            )

            timeframe_row = (
