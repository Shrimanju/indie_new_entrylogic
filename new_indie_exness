            )
            inactive_pnl_row = (
                '| ' + 'Inactive Trade P/L'.ljust(label_width) + ' | '
                + ('$' + str(round(report_inactive_pnl[0], 2))).ljust(value_width) + ' |'
            )

            sl_row = (
