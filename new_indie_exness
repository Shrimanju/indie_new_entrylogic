            else:
                pending_entry_touched = self.high[0] >= pending_entry_value
                pending_sl_touched = self.high[0] >= pending_sl_value
                pending_tp_touched = self.low[0] <= pending_tp_value

            pending_exit_touched = pending_sl_touched or pending_tp_touched
            if pending_exit_touched:
                # Conservative rule: if entry and pre-entry SL/TP are touched
