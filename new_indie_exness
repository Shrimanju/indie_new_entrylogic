                elif side[0] == -1.0:
                    report_hit_sl = self.high[0] >= sl[0]
                    report_hit_tp = self.low[0] <= tp[0]
                    if report_hit_sl or report_hit_tp:
                        exit_now = True

            # A stop counts as a trailing-SL hit only after the adaptive
            # trailing manager has actually moved the original stop level.
            report_hit_trailing_sl = (
                report_hit_sl and trail_last_update_bar[0] >= 0.0
            )

            if exit_now:

                # Count only SL/TP exits. Manual exits remain excluded.
                if report_hit_sl or report_hit_tp:

                    # SL takes priority if SL and TP are both touched
                    # in the same candle.
                    if report_hit_sl:
                        realized_exit_price = sl[0]
                    else:
                        realized_exit_price = tp[0]

                    realized_pnl = (
                        (realized_exit_price - entry[0])
                        * side[0]
                        * self.contract_size
                        * trade_lot[0]
                    )

                    # ========================================
